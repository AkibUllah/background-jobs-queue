# Redis connection used by workers, the dashboard and the CLI.
# Leave unset to use the in-memory backend (single process, dev/tests only).
JOBQ_REDIS_URL=redis://localhost:6379/0

# Key prefix so several applications can share one Redis.
JOBQ_PREFIX=jobq:

# Dotted path to the JobQ application object the CLI should load.
JOBQ_APP=examples.demo_app:app

# Dashboard API bind address and CORS origins (comma separated) for the Vite dev server.
JOBQ_DASHBOARD_HOST=0.0.0.0
JOBQ_DASHBOARD_PORT=8000
JOBQ_CORS_ORIGINS=http://localhost:5173

# Worker defaults
JOBQ_QUEUES=high,default,low
JOBQ_CONCURRENCY=10
JOBQ_LOG_LEVEL=INFO
